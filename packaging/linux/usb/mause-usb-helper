#!/usr/bin/python3 -I
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

VERSION = "1"
PATH = "/usr/sbin:/usr/bin:/sbin:/bin"


def busid(value):
    if len(value) > 32 or re.fullmatch(r"[1-9][0-9]*-[0-9]+(?:\.[0-9]+)*", value) is None:
        raise ValueError("Geçersiz USB cihaz adresi")
    return value


def port(value):
    if re.fullmatch(r"[0-9]{1,5}", value) is None or not 1 <= int(value) <= 65535:
        raise ValueError("Geçersiz yerel port")
    return str(int(value))


def arguments(args):
    if len(args) == 2 and args[0] in ("bind", "unbind", "detach"):
        return args[0], busid(args[1]), None
    if len(args) == 3 and args[0] == "attach":
        return "attach", busid(args[1]), port(args[2])
    raise ValueError("Yalnız bind, unbind, attach ve detach işlemleri desteklenir")


def executable(name):
    for directory in PATH.split(":"):
        path = Path(directory, name)
        if path.is_file():
            info = path.stat()
            if info.st_uid != 0 or info.st_mode & 0o022 or not info.st_mode & 0o111:
                raise ValueError(f"Güvenilmeyen sistem aracı: {path}")
            return str(path)
    raise ValueError(f"Gerekli sistem aracı bulunamadı: {name}")


def run(name, *args, allowed=(0,)):
    result = subprocess.run([executable(name), *args], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, timeout=25, env={"PATH": PATH, "LC_ALL": "C"})
    if result.returncode not in allowed:
        raise RuntimeError(result.stdout.strip() or f"{name} başarısız")
    return result


def physical_device(value):
    path = Path("/sys/bus/usb/devices", value)
    if not path.is_dir() or not path.resolve().is_relative_to("/sys/devices"):
        raise ValueError("USB cihazı bulunamadı")
    if (path / "bDeviceClass").read_text().strip() == "09":
        raise ValueError("USB dağıtıcıları paylaşılamaz")


def protect_server():
    for tool in ("iptables", "ip6tables"):
        rule = ("INPUT", "-p", "tcp", "--dport", "3240", "!", "-i", "lo", "-j", "DROP")
        found = run(tool, "-w", "5", "-C", *rule, allowed=(0, 1))
        if found.returncode == 1:
            run(tool, "-w", "5", "-I", *rule)


def import_port(text, device):
    current = None
    for line in text.splitlines():
        found = re.match(r"\s*Port ([0-9]{1,3}):", line)
        if found:
            current = found.group(1)
        if current is not None and re.search(r"usbip://127\.0\.0\.[12]:[0-9]+/" + re.escape(device) + r"\s*$", line):
            return current
    raise ValueError("Cihaz bu bilgisayarın yerel USB tüneline bağlı değil")


def operate(operation, device, local_port=None):
    if operation == "bind":
        physical_device(device)
        run("modprobe", "usbip-host")
        protect_server()
        if run("pgrep", "-x", "usbipd", allowed=(0, 1)).returncode == 1:
            run("usbipd", "-D")
        result = run("usbip", "bind", "-b", device, allowed=(0, 1))
        if result.returncode and "already bound" not in result.stdout:
            raise RuntimeError(result.stdout.strip() or "USB paylaşımı başlatılamadı")
    elif operation == "unbind":
        physical_device(device)
        run("usbip", "unbind", "-b", device)
    elif operation == "attach":
        run("modprobe", "vhci-hcd")
        run("usbip", "--tcp-port", local_port, "attach", "-r", "127.0.0.1", "-b", device)
    else:
        imported = import_port(run("usbip", "port").stdout, device)
        run("usbip", "detach", "-p", imported)


def main():
    try:
        if sys.argv[1:] == ["check"]:
            print(VERSION)
            return 0
        operation, device, local_port = arguments(sys.argv[1:])
        if os.geteuid() != 0:
            raise PermissionError("USB yardımcısı polkit üzerinden çalıştırılmalı")
        operate(operation, device, local_port)
        return 0
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
